# The Moonlit Haven — Backend environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Resend API (https://resend.com) — use a "Sending access" scoped key, not full access.
RESEND_API_KEY=re_your_actual_key_here

# Must be an address on a domain you've verified in Resend
# (or onboarding@resend.dev for quick testing before you verify a domain).
RESEND_FROM_EMAIL=Moonlit Haven <notifications@yourdomain.com>

# Where grievance notifications should be delivered (your personal email)
RECIPIENT_EMAIL=your_email@example.com

# Frontend origin allowed to call this API (set to your deployed frontend URL)
FRONTEND_ORIGIN=http://localhost:5500

# Local server settings
PORT=5000
FLASK_DEBUG=true